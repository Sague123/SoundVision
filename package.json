{
  "name": "soundvision",
  "productName": "SoundVision",
  "version": "3.0.0-stage0",
  "private": true,
  "description": "Cover-centred audio-reactive light show for a TV",
  "author": "SoundVision",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fake": "electron-vite dev -- --fake-helper --audio=test",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "helpers": "node scripts/build-helpers.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
